#!/usr/bin/env bash
set -eu

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) : ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
REPO_ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
BINARY="${CARGO_TARGET_DIR:-$REPO_ROOT/target}/debug/pueue-agent"

if [ ! -x "$BINARY" ]; then
  echo "error: Rust development binary is missing: $BINARY" >&2
  echo "build it with: cargo build --manifest-path '$REPO_ROOT/Cargo.toml'" >&2
  exit 1
fi

exec "$BINARY" "$@"
