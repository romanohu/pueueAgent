[Unit]
Description=pueue-agent supervisor
After=default.target

[Service]
Type=simple
ExecStart=${PUEUE_AGENT_BIN} daemon --foreground --pueue-config ${PUEUE_CONFIG}
Environment=PATH=${PUEUE_AGENT_PATH}
Environment=PUEUE_AGENT_STATE_DIR=${PUEUE_AGENT_STATE_DIR}
WorkingDirectory=${PUEUE_AGENT_WORKING_DIR}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
